# Google AI Studio (https://aistudio.google.com/apikey) で発行した Gemini API キー
GEMINI_API_KEY=your-api-key-here

# 使用モデル。対話の質を優先するなら pro、応答速度を優先するなら gemini-3-flash-preview。
GEMINI_MODEL=gemini-3-pro-preview

# 思考の深さ: MINIMAL / LOW / MEDIUM / HIGH (Gemini 3 系のみ有効)
GEMINI_THINKING_LEVEL=LOW

# 会話とランナープロフィールの保存先ディレクトリ (既定: <repo>/.data)
COACH_DATA_DIR=.data
