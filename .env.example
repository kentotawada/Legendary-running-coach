# Google AI Studio (https://aistudio.google.com/apikey) で発行した Gemini API キー
GEMINI_API_KEY=your-api-key-here

# ふだんの会話に使うモデル（既定: gemini-3-flash-preview）。
# **費用のほぼ全部がここで決まります。** 上位のモデルにすると1通あたり6倍以上かかります。
# 実測では、道具を使う1通で入力52,170トークン・約17円（Pro）でした。
# 詳しくは docs/cost-and-revenue.md。
GEMINI_MODEL=gemini-3-flash-preview

# 画像を読む時だけ使うモデル（既定: gemini-3-pro-preview）。
# 時計の画面やフォームの写真の読み取りは、取り違えると助言そのものが狂うので、
# ここは安いほうに倒しません。使えない時は上のモデルで読み取りを試します。
GEMINI_MODEL_VISION=gemini-3-pro-preview

# 思考の深さ: MINIMAL / LOW / MEDIUM / HIGH (Gemini 3 系のみ有効)
GEMINI_THINKING_LEVEL=LOW

# 会話とランナープロフィールの保存先ディレクトリ (既定: <repo>/.data)
# Supabase を設定した場合は使われません。
COACH_DATA_DIR=.data

# --- Supabase（データベース＋ログイン）---
# 未設定でもアプリは動きます（この端末・インスタンス限りの保存になります）。
# 設定すると、記録が永続化され、ログインでどの端末からでも同じ記録が見られます。
# 取得場所: Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# 「anon public」キー（新しい画面では「publishable」）。ブラウザに出て構わないキーです。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 「service_role」キー（新しい画面では「secret」）。
# **絶対にブラウザへ渡さないでください。** サーバー側でのみ使われます。
SUPABASE_SERVICE_ROLE_KEY=

# ログイン後に戻ってくるURL。未設定ならリクエスト元から自動判定します。
# 本番の固定ドメインがある場合のみ設定してください。
NEXT_PUBLIC_SITE_URL=

# --- 1日に使える回数（強く推奨）---
# 1回の返事ごとにモデルの利用料がかかります。上限が無いと、URL を知っている誰でも
# こちらの負担で好きなだけ話せてしまいます（src/lib/quota.ts）。
#   ゲスト 1日15回・画像10枚 / ログイン済み 1日40回・画像40枚 / 同じ回線から 1日80回 / 全体 1日300回
# 数えるには、supabase/schema.sql の「4. 使った回数」を SQL Editor で実行してください。
# 実行できているかは /api/health の "usage": "ok" で確かめられます。
#
# アプリ全体で1日に話せる回数。予算から決めてください（既定: 120）。
# **これは使い心地の設定ではなく、1日の請求はここで止まるという約束の数字です。**
# 目安: /admin の「1回あたり」の費用 × この回数 が、1日に払ってよい上限。
# 120 は 30人 × 1日4回。軽いモデルなら1日約300円、月約9,400円が最悪値。
DAILY_TURN_BUDGET=120
# 持ち主のメールアドレス（カンマ区切り）。ログインしていれば上限をかけません。
ADMIN_EMAILS=

# --- 運営の画面 /admin（任意）---
# ADMIN_EMAILS に入れたアドレスでログインしている時だけ開けます（それ以外の人には「無い」ページになります）。
# 使い始めた人・話した回数・費用・上限に当たった数・返答への評価・不具合を、日ごとに見られます。
# 見るには supabase/schema.sql の「4.」と「5.」を実行しておいてください。
#
# 費用を円で出すための、モデルの単価（100万トークンあたりの米ドル）。「送る,書く」の順。
# 単価はモデルや時期で変わるので、Google の料金表を見て入れてください。例: 2,12
GEMINI_PRICE_PER_MTOK=

# --- 規約・プライバシーポリシー（公開前に必須）---
# /privacy・/terms・/disclaimer に出す運営者の名前と、問い合わせ先。
# 未設定のままだと、各ページの上に「公開前に設定してください」と赤く出ます。
# 個人名・屋号・会社名のどれでも構いません。連絡先は専用のアドレスを用意するのがおすすめです。
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# --- 1日の区切り（任意）---
# スタンプ・連続日数・本番までの日数を、どの地域の時刻で数えるか。
# 未設定なら Asia/Tokyo。区切りは深夜2時で、夜遅い練習もその日のぶんとして数えます。
COACH_TIMEZONE=Asia/Tokyo

# --- プッシュ通知（任意）---
# 鍵の作り方: npx web-push generate-vapid-keys
# 未設定なら、通知の項目そのものを画面に出しません。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 送信者の連絡先。プッシュサービス側が求めます（mailto: で始める）。
VAPID_SUBJECT=mailto:you@example.com
# 定期送信の入口を守る合言葉。**未設定なら送信口は動きません**（誰でも叩ける通知は危険なため）。
# Vercel では自動で Authorization: Bearer <CRON_SECRET> を付けて叩いてくれます。
CRON_SECRET=

# --- ランニングアプリ連携（任意）---
# https://www.strava.com/settings/api でアプリを登録して取得します。
# Authorization Callback Domain には、このアプリのドメイン（例: your-app.vercel.app）を
# 入れてください（https:// や /api/... は不要です）。
# 未設定なら、連携の項目そのものを画面に出しません。
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- 商品の候補（任意）---
# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）のアプリID。
# これを設定すると、コーチが実在する商品の候補の中から選んで勧められるようになります。
# 未設定の場合は、従来どおりカテゴリの検索リンクだけを出します
# （モデルに商品名を書かせることは、どちらの場合もありません）。
RAKUTEN_APP_ID=

# --- アフィリエイト（任意）---
# 設定するとおすすめ商品のリンクがアフィリエイトリンクになり、
# 画面に「PR・広告リンクを含みます」と表示されます（景品表示法のステマ規制対応）。
# 未設定なら、ただの検索リンクとして扱われます。
AMAZON_ASSOCIATE_TAG=
RAKUTEN_AFFILIATE_ID=
# 楽天のリンク形式が変わった場合の上書き用。{url} と {id} が差し込まれます。
RAKUTEN_LINK_TEMPLATE=
